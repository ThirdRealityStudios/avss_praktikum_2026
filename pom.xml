<?xml version="1.0" encoding="UTF-8"?> <!-- This is an old version from 1st appointment!! It was not yet adjusted for the 2nd appointment!! -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>de.fhms.jp253163.avss.arch.mvp.lms</groupId> <!-- Make sure, the project code ALWAYS is inside directory src/main/java/... because that is the mandatory standard! -->
    <artifactId>executable-gui-standalone</artifactId> <!-- This is basically how the resulting JAR should be named after successful deploy - whereas the JAR name will not only contain this but also other automatically generated information, e.g. date and time -->
    <version>1.3-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source> <!-- 21 represents the Java language level - it should be identical with the value taken in the project settings -->
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Source: https://mvnrepository.com/artifact/com.google.code.gson/gson -->

        <dependency>
            <groupId>de.fhms.jp253163.avss.arch.mvp.lms.presenter</groupId>
            <artifactId>presenter</artifactId>
            <version>1.3-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>de.fhms.jp253163.avss.arch.mvp.lms.view</groupId>
            <artifactId>gui</artifactId>
            <version>1.3-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>de.fhms.jp253163.avss.arch.mvp.lms.model</groupId>
            <artifactId>logik</artifactId>
            <version>1.3-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

    </dependencies>

    <distributionManagement>
        <repository>
            <id>gitlab-fhms</id>
            <url>https://git.fh-muenster.de/api/v4/projects/23698/packages/maven</url> <!-- The project ID can be retrieved when you call the "Projects" page in your GitLab and click on the 3 dots in order to copy the project ID. Also, GitLab always expects something like: https://git.fh-muenster.de/api/v4/projects/<MyProjectID>/packages/maven, whereas "/packages/maven" is static / always like this. -->
        </repository>
    </distributionManagement>

    <build> <!-- This build block is used in order to load the Maven Shade plugin. It will help building a fat frontend JAR in order to deploy the fat JAR to Maven. Without the plugin, only a normal JAR is deployed without contained dependency byte-code. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>de.fhms.jp253163.avss.arch.mvp.lms.Main</mainClass> <!-- This dotted path notation should point to the de.fhms.jp253163.avss.arch.mvp.Main class, so always something like "my.project.de.fhms.jp253163.avss.arch.mvp.Main" -->
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>